# Copy this file to .env (same folder) and fill in the keys for the engines you use.
# .env is git-ignored. Variables already set in your environment take precedence,
# and --api-key on the command line overrides both.

# --engine deepseek   https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# --engine claude     https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# --engine openai     any OpenAI-compatible API (OpenAI, Qwen, Kimi, local Ollama...)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# --engine deepl
DEEPL_API_KEY=

# --engine microsoft  (Azure Translator)
MICROSOFT_TRANSLATOR_KEY=
MICROSOFT_TRANSLATOR_REGION=

# --engine yandex
YANDEX_API_KEY=
